{
  "maximum_archive_mb": 100,
  "maximum_uncompressed_mb": 250,
  "maximum_single_file_mb": 150,
  "maximum_files": 2000,
  "maximum_compression_ratio": 200,
  "required_files": ["submission.json", "README.md", "requirements.txt"],
  "maximum_source_file_kb": 512,
  "maximum_command_items": 16,
  "maximum_command_item_length": 512,
  "allowed_extensions": [
    ".py", ".json", ".txt", ".md", ".toml", ".yaml", ".yml",
    ".bin", ".onnx", ".npz", ".npy"
  ],
  "allowed_dependencies": [],
  "forbidden_directories": [
    ".git", ".venv", "venv", "env", "__pycache__", "node_modules", "logs", "tmp"
  ],
  "forbidden_filenames": [
    ".env", "credentials.json", "secrets.json", "id_rsa", "id_ed25519"
  ],
  "forbidden_extensions": [
    ".exe", ".dll", ".bat", ".cmd", ".ps1", ".com", ".msi", ".pem", ".key",
    ".pt", ".pth", ".pkl", ".pickle", ".joblib", ".so", ".dylib"
  ],
  "forbidden_python_imports": [
    "builtins", "ctypes", "ftplib", "http", "importlib", "marshal", "multiprocessing",
    "os", "pickle", "shelve", "shutil", "smtplib", "socket", "subprocess", "telnetlib",
    "urllib", "webbrowser", "winreg"
  ],
  "forbidden_python_calls": [
    "__import__", "breakpoint", "compile", "eval", "exec",
    "Path.chmod", "Path.mkdir", "Path.open", "Path.rename", "Path.replace", "Path.rmdir",
    "Path.symlink_to", "Path.touch", "Path.unlink", "Path.write_bytes", "Path.write_text"
  ]
}
